# Environment Variables Template
# Copy this to .env and fill in your actual values

# OpenRouter API (for LLM responses)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Configuration (for vector database)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: Additional Search APIs
SERPER_API_KEY=your_serper_api_key_here  # For enhanced Google search
BING_SEARCH_KEY=your_bing_search_key_here  # For Bing search

# Deployment Configuration
PORT=8001
ENVIRONMENT=production
DEBUG=false

# Model Configuration
VECTOR_BACKEND=supabase  # Options: supabase, local
MODEL_DEVICE=cpu  # Options: cpu, cuda (if GPU available)

# Timeout Settings (in seconds)
VECTOR_TIMEOUT=5
ENHANCED_TIMEOUT=10
INTERNET_TIMEOUT=5
TOTAL_TIMEOUT=20